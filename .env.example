# 大师擂台 - 环境配置
# 复制此文件为 .env 并填入你的 API Key

# ============================================
# LLM 配置
# ============================================
# LLM 服务提供商: openai / deepseek / anthropic
LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek 配置（如果使用 DeepSeek）
# LLM_PROVIDER=deepseek
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# LLM 重试配置
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源，* 表示允许所有（开发环境）
# 生产环境建议设置为具体域名，多个用逗号分隔
# 例如: CORS_ORIGINS=https://example.com,https://app.example.com
CORS_ORIGINS=*

# ============================================
# 股价数据源配置
# ============================================
# 数据提供商优先级: twelvedata > alphavantage > finnhub > yahoo
# 默认使用 Twelve Data（推荐，数据最准确）
STOCK_DATA_PROVIDER=twelvedata

# Twelve Data API Key（免费申请: https://twelvedata.com/pricing）
# 免费额度: 800 次/天，支持全球股票/ETF/加密货币
# 使用 "demo" 可测试，但正式使用请申请免费 key
TWELVE_DATA_API_KEY=demo

# 行情缓存时间（秒），用于减少免费 API 消耗
STOCK_CACHE_TTL_SECONDS=300

# Alpha Vantage API Key（免费申请: https://www.alphavantage.co/support/#api-key）
# 免费额度: 25 次/天
ALPHA_VANTAGE_API_KEY=your-alphavantage-key-here

# Finnhub API Key（免费申请: https://finnhub.io/register）
# 免费额度: 60 次/分钟
FINNHUB_API_KEY=your-finnhub-key-here
